#pragma kernel StylizeTexture

Texture2D<float4> Input;
RWTexture2D<float4> Result;

float _BlendStrength;
int _SearchRadius;

[numthreads(8, 8, 1)]
void StylizeTexture(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    Result.GetDimensions(width, height);

    if (id.x >= width || id.y >= height) return;

    float4 centerColor = Input[id.xy];

    float4 buckets[8];
    float counts[8];
    int i;

    for (i = 0; i < 8; i++)
    {
        buckets[i] = float4(0, 0, 0, 0);
        counts[i] = 0;
    }

    for (int x = -_SearchRadius; x <= _SearchRadius; x++)
    {
        for (int y = -_SearchRadius; y <= _SearchRadius; y++)
        {
            int2 coord;
            coord.x = clamp((int)id.x + x, 0, (int)width - 1);
            coord.y = clamp((int)id.y + y, 0, (int)height - 1);

            float4 s = Input[coord];
            float lum = dot(s.rgb, float3(0.299, 0.587, 0.114));
            int b = clamp((int)(lum * 7.99), 0, 7);

            buckets[b] += s;
            counts[b] += 1;
        }
    }

    float4 dominant = centerColor;
    float maxCount = 0;

    for (i = 0; i < 8; i++)
    {
        if (counts[i] > maxCount)
        {
            maxCount = counts[i];
            dominant = buckets[i] / counts[i];
        }
    }

    Result[id.xy] = lerp(centerColor, dominant, _BlendStrength);
}