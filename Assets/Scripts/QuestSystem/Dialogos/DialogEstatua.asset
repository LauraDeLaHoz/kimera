  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: m
    Text: "Seg\xFAn mis cuentas, para ese entonces ya estaba en proceso la extencion
      de las plantas, pero bajo su cuidado esta ciudad no pereci\xF3 por muchos a\xF1os,
